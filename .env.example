# Application
APP_ENV=development            # development | production
LOG_FORMAT=text                # text | json
LOG_LEVEL=info                 # debug | info | warn | error

# HTTP
CORS_ALLOWED_ORIGINS=*         # comma-separated, e.g. https://app.example.com
# SKIP_MIGRATE=true            # `api` applies pending migrations on start unless set

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_SSLMODE=disable
DATABASE_MAX_CONNS=0           # 0 = NumCPU * 4

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication (secret must be >= 32 bytes in production)
AUTH_JWT_SECRET=dev-secret-change-me
AUTH_JWT_ISSUER=api-core
AUTH_JWT_AUDIENCE=api-core
AUTH_JWT_EXP_MINUTES=60

# Google OAuth 2.0 (leave all three empty to disable; /auth/google/* then returns 503)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile
